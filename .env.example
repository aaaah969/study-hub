# Copy this file to .env and fill in your key.

# Google Gemini (free): get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional
PORT=3000
# Model names change over time; if Google retires one, set current ones here.
# GEMINI_MODEL_QUICK=gemini-3.5-flash-lite
# GEMINI_MODEL_DEFAULT=gemini-3.5-flash
# GEMINI_MODEL_COMPLEX=gemini-3.5-flash
# How many AI requests run at once (default 2 for Gemini's free tier).
# AI_CONCURRENCY=2

# Optional: use Anthropic Claude (paid) instead. Used when no GEMINI_API_KEY is set,
# or always with AI_PROVIDER=anthropic. STUDYHUB_API_KEY works as the key name too.
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# MODEL_QUICK=claude-haiku-5-5
# MODEL_DEFAULT=claude-sonnet-5-5
# MODEL_COMPLEX=claude-opus-5-5
